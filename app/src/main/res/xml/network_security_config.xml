<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP to localhost for the embedded iframe server.
         The WebView loads iframe HTML from http://127.0.0.1:{port}/ to give
         YouTube's Iframe API a real origin (required for embed permission). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
