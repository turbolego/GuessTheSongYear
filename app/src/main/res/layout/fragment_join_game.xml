<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/textViewJoinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/join_game_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/amber_accent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Player name input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/player_name_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewJoinTitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextPlayerName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/body_text"
            android:textColorHint="@color/muted_text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Host IP input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutHostIp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/join_host_ip_hint"
        app:layout_constraintEnd_toStartOf="@+id/buttonScanQr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutName">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextHostIp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="text|phone"
            android:maxLines="1"
            android:textColor="@color/body_text"
            android:textColorHint="@color/muted_text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Scan QR button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonScanQr"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text=""
        android:contentDescription="@string/join_scan_qr_desc"
        app:icon="@android:drawable/ic_menu_camera"
        app:iconSize="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textInputLayoutHostIp"
        app:layout_constraintTop_toTopOf="@+id/textInputLayoutHostIp" />

    <!-- Scan row: LAN refresh + Connect + Bluetooth scan -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonRefreshScan"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/join_scan_button"
        app:layout_constraintEnd_toStartOf="@+id/buttonScanBluetooth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutHostIp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonScanBluetooth"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/join_scan_bt_button"
        app:layout_constraintEnd_toStartOf="@+id/buttonConnect"
        app:layout_constraintStart_toEndOf="@+id/buttonRefreshScan"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutHostIp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonConnect"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/join_connect_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/buttonScanBluetooth"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutHostIp" />

    <!-- Connection status -->
    <TextView
        android:id="@+id/textViewConnectionStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:textColor="@color/body_text"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonConnect"
        tools:text="Søker etter spill på LAN..."
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/progressBarJoin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewConnectionStatus" />

    <!-- Discovered hosts list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewDiscoveredHosts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarJoin"
        tools:visibility="visible"
        tools:listitem="@android:layout/simple_list_item_2" />

</androidx.constraintlayout.widget.ConstraintLayout>
