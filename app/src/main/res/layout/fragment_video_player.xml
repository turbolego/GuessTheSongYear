<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:background="@color/ink">

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- VIDEO AREA — YouTube IFrame Player API (official, Play Store)  -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@android:color/black">

        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtubePlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:enableAutomaticInitialization="false" />

    </FrameLayout>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- CONTROLS AREA — NestedScrollView supports nested scrolling with  -->
    <!-- RecyclerView so the player list can scroll properly              -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <!-- Countdown (3-2-1 when loading next song) -->
            <TextView
                android:id="@+id/textViewCountdown"
                style="@style/CountdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />

            <!-- Song Info -->
            <TextView
                android:id="@+id/textViewSongTitle"
                style="@style/SongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="Shape of You" />

            <TextView
                android:id="@+id/textViewArtist"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="4dp"
                tools:text="Ed Sheeran" />

            <!-- Score + Streak (single-player) / Leaderboard (multiplayer) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/textViewScore"
                    style="@style/BodyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/score_label_zero"
                    tools:text="Poeng: 0" />

                <TextView
                    android:id="@+id/textViewLeaderboard"
                    style="@style/BodyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:text="🏆 Runde 1/10"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Progress (loading) -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Guess Input Row (single-player) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/editTextGuess"
                    style="@style/GuessInput"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:hint="@string/edit_guess_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/buttonGuess"
                    style="@style/PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="@string/submit_guess" />
            </LinearLayout>

            <!-- Year Picker Button -->
            <Button
                android:id="@+id/buttonYearPicker"
                style="@style/SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Velg år" />

            <!-- Year NumberPicker — appears between edit text and feedback -->
            <NumberPicker
                android:id="@+id/numberPickerYear"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Feedback -->
            <TextView
                android:id="@+id/textViewFeedback"
                style="@style/FeedbackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:text="Korrekt! (+50 poeng)"
                tools:visibility="visible" />

            <!-- Hint -->
            <TextView
                android:id="@+id/textViewHint"
                style="@style/FeedbackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:text="💡 Tiår: 2010-tallet"
                tools:visibility="visible" />

            <!-- Next Video / Reveal Answers / YouTube fallback buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonNextVideo"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next_video"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/buttonRevealAnswers"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reveal_answers"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/buttonYoutubeFallback"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶ Åpne i YouTube"
                    android:visibility="gone"
                    android:textColor="@color/ink"
                    android:backgroundTint="@color/amber_accent" />
            </LinearLayout>

            <!-- Blocked-video info -->
            <TextView
                android:id="@+id/textViewBlockedInfo"
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="4dp"
                android:visibility="gone"
                tools:text="⚠ Videoen kan ikke spilles av i appen. Trykk 'Åpne i YouTube' for å se den." />

            <!-- Network Client Label -->
            <TextView
                android:id="@+id/textViewClientLabel"
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="4dp"
                android:visibility="gone"
                tools:text="Venter på vert..."
                tools:visibility="visible" />

            <!-- Multiplayer: Player Guess list (inside NestedScrollView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewPlayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:nestedScrollingEnabled="true"
                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listItem="@layout/item_player_guess"
                tools:visibility="visible"
                tools:itemCount="4" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>