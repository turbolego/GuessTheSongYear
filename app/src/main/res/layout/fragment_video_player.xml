<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- YouTube Player -->
    <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
        android:id="@+id/youtube_player_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showFullScreenButton="true"
        app:enableAutomaticInitialization="false" />

    <!-- Video overlay (toggle to hide video, keep audio) -->
    <View
        android:id="@+id/videoOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/ink"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/youtube_player_view"
        app:layout_constraintStart_toStartOf="@+id/youtube_player_view"
        app:layout_constraintTop_toTopOf="@+id/youtube_player_view"
        app:layout_constraintBottom_toBottomOf="@+id/youtube_player_view" />

    <TextView
        android:id="@+id/textViewOverlayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/overlay_audio_only"
        android:textColor="@color/muted_text"
        android:textSize="14sp"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/videoOverlay"
        app:layout_constraintEnd_toEndOf="@+id/videoOverlay"
        app:layout_constraintStart_toStartOf="@+id/videoOverlay"
        app:layout_constraintTop_toTopOf="@+id/videoOverlay" />

    <!-- Current player (multiplayer) + Score bar -->
    <TextView
        android:id="@+id/textViewCurrentPlayer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textColor="@color/amber_accent"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/youtube_player_view"
        tools:text="Ola sin tur"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textViewScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/amber_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/buttonToggleVideo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewCurrentPlayer"
        tools:text="Score: 0  |  Streak: 0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonToggleVideo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="@string/btn_hide_video"
        android:textSize="11sp"
        android:textColor="@color/muted_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewCurrentPlayer" />

    <!-- Leaderboard (multiplayer) -->
    <TextView
        android:id="@+id/textViewLeaderboardLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="16dp"
        android:text="🏆 Ledertavle"
        android:textSize="12sp"
        android:textColor="@color/muted_text"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewScore"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textViewLeaderboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="16dp"
        android:padding="8dp"
        android:background="@drawable/input_background"
        android:textSize="12sp"
        android:textColor="@color/body_text"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewLeaderboardLabel"
        tools:text="🥇 Ola — 50 poeng\n🥈 Kari — 30 poeng"
        tools:visibility="visible" />

    <!-- Countdown (before video starts) -->
    <TextView
        android:id="@+id/textViewCountdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/amber_accent"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewLeaderboard"
        tools:text="3" />

    <!-- Hint text -->
    <TextView
        android:id="@+id/textViewHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        android:textSize="12sp"
        android:textColor="@color/muted_text"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewCountdown"
        tools:text="Tiår: 2000-tallet | Visninger: 45M" />

    <!-- Guess input area -->
    <EditText
        android:id="@+id/editTextGuess"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:inputType="number"
        android:maxLength="4"
        android:hint="@string/guess_hint"
        android:background="@drawable/input_background"
        android:paddingHorizontal="16dp"
        android:textColor="@color/body_text"
        android:textColorHint="@color/muted_text"
        android:imeOptions="actionDone"
        android:enabled="false"
        app:layout_constraintEnd_toStartOf="@+id/buttonGuess"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewHint"
        tools:text="2005" />

    <Button
        android:id="@+id/buttonGuess"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="8dp"
        android:text="@string/btn_guess"
        android:enabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/editTextGuess"
        app:layout_constraintTop_toBottomOf="@+id/textViewHint" />

    <!-- Feedback text -->
    <TextView
        android:id="@+id/textViewFeedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextGuess"
        tools:text="Perfekt! +50 poeng 🎯"
        tools:visibility="visible" />

    <!-- Release year (shown after guess) -->
    <TextView
        android:id="@+id/textViewSongYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/amber_accent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewFeedback"
        tools:text="Utgitt i: 2005" />

    <!-- Next Video / Next Player button -->
    <Button
        android:id="@+id/buttonNextVideo"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/next_video"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewSongYear" />

    <!-- Progress bar (loading) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>