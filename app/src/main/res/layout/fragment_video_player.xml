<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintHeight_max="@dimen/video_max_height"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtubePlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:enableAutomaticInitialization="false" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/game_controls_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/video_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_horizontal_padding"
            android:paddingTop="@dimen/content_vertical_padding"
            android:paddingEnd="@dimen/content_horizontal_padding"
            android:paddingBottom="@dimen/content_vertical_padding_large">

            <TextView
                android:id="@+id/textViewCountdown"
                style="@style/CountdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textViewSongTitle"
                style="@style/SongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="@dimen/game_content_max_width"
                tools:text="Shape of You" />

            <TextView
                android:id="@+id/textViewArtist"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="@dimen/game_content_max_width"
                android:paddingBottom="4dp"
                tools:text="Ed Sheeran" />

            <TextView
                android:id="@+id/textViewArcadeTurn"
                style="@style/FeedbackText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="@dimen/game_content_max_width"
                android:visibility="gone"
                tools:text="Alex's turn"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/textViewScore"
                    style="@style/BodyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/score_label_zero"
                    tools:text="Poeng: 0" />

                <TextView
                    android:id="@+id/textViewLeaderboard"
                    style="@style/BodyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:text="Runde 1/10"
                    tools:visibility="visible" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/editTextGuess"
                    style="@style/GuessInput"
                    android:layout_width="@dimen/year_input_width"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:hint="@string/edit_guess_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/buttonGuess"
                    style="@style/PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="@string/submit_guess" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonYearPicker"
                style="@style/SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/select_year" />

            <NumberPicker
                android:id="@+id/numberPickerYear"
                android:layout_width="@dimen/year_picker_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewFeedback"
                style="@style/FeedbackText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:maxWidth="@dimen/game_content_max_width"
                android:visibility="gone"
                tools:text="Korrekt! (+50 poeng)"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textViewHint"
                style="@style/FeedbackText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="@dimen/game_content_max_width"
                android:visibility="gone"
                tools:text="Tiår: 2010-tallet"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonNextVideo"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next_video"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/buttonRevealAnswers"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reveal_answers"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/buttonYoutubeFallback"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/amber_accent"
                    android:text="@string/watch_on_youtube"
                    android:textColor="@color/ink"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/textViewBlockedInfo"
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="@dimen/game_content_max_width"
                android:paddingTop="4dp"
                android:visibility="gone"
                tools:text="Videoen kan ikke spilles av i appen. Trykk Åpne i YouTube." />

            <TextView
                android:id="@+id/textViewClientLabel"
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="4dp"
                android:visibility="gone"
                tools:text="Venter på vert..."
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewPlayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listItem="@layout/item_player_guess"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
