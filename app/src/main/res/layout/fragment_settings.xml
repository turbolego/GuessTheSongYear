<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/ink">

    <!-- Radio group: Video source selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_video_source"
        android:textColor="@color/amber_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <RadioGroup
        android:id="@+id/radioGroupSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioDefaultList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="@string/settings_use_default_list"
            android:textColor="@color/body_text"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioCustomList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="@string/settings_use_custom_list"
            android:textColor="@color/body_text" />
    </RadioGroup>

    <!-- Custom list input area (visible only when "Your own list" is selected) -->
    <LinearLayout
        android:id="@+id/layoutCustomList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="12dp"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_custom_list_label"
            android:textColor="@color/muted_text"
            android:textSize="14sp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/editCustomList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/input_background"
            android:gravity="top|start"
            android:hint="@string/settings_custom_list_hint"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="@color/body_text"
            android:textColorHint="@color/muted_text"
            android:textSize="14sp"
            tools:text="https://youtu.be/dQw4w9WgXcQ\nhttps://www.youtube.com/watch?v=9bZkp7q19f0\nfJ9rUzIMcZQ" />

        <!-- Validation result -->
        <TextView
            android:id="@+id/textValidationResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:textColor="@color/amber_accent"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="✅ 42 videoer funnet!"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/buttonSave"
            style="@style/PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_save" />

        <Button
            android:id="@+id/buttonCancel"
            style="@style/SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/cancel" />
    </LinearLayout>

</LinearLayout>
