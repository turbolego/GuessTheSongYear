<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_horizontal_padding"
            android:paddingTop="@dimen/content_vertical_padding"
            android:paddingEnd="@dimen/content_horizontal_padding"
            android:paddingBottom="@dimen/content_vertical_padding">

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_video_source"
                android:textColor="@color/amber_accent"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioDefaultList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:paddingVertical="8dp"
                    android:text="@string/settings_use_default_list"
                    android:textColor="@color/body_text" />

                <RadioButton
                    android:id="@+id/radioCustomList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingVertical="8dp"
                    android:text="@string/settings_use_custom_list"
                    android:textColor="@color/body_text" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/layoutCustomList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/MutedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_custom_list_label" />

                <EditText
                    android:id="@+id/editCustomList"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/input_background"
                    android:gravity="top|start"
                    android:hint="@string/settings_custom_list_hint"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/body_text"
                    android:textColorHint="@color/muted_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textValidationResult"
                    style="@style/MutedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:textColor="@color/amber_accent"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/muted_text" />

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_game_mode"
                android:textColor="@color/amber_accent"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupGameMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioClassic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingVertical="8dp"
                    android:text="@string/settings_game_mode_classic"
                    android:textColor="@color/body_text" />

                <RadioButton
                    android:id="@+id/radioArcade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingVertical="8dp"
                    android:text="@string/settings_game_mode_arcade"
                    android:textColor="@color/body_text" />
            </RadioGroup>

            <TextView
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_game_mode_help" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/muted_text" />

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_randomization"
                android:textColor="@color/amber_accent"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupRandomization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioPureRandom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingVertical="8dp"
                    android:text="@string/settings_randomization_pure"
                    android:textColor="@color/body_text" />

                <RadioButton
                    android:id="@+id/radioPrioritizeModern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingVertical="8dp"
                    android:text="@string/settings_randomization_modern"
                    android:textColor="@color/body_text" />

                <RadioButton
                    android:id="@+id/radioCustomWeights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingVertical="8dp"
                    android:text="@string/settings_randomization_custom"
                    android:textColor="@color/body_text" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/layoutDecadeWeights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/muted_text" />

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_history"
                android:textColor="@color/amber_accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHistoryStatus"
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                tools:text="42 remembered songs · 3 duplicate candidates skipped" />

            <Button
                android:id="@+id/buttonClearHistory"
                style="@style/SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_clear_history" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_horizontal_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/content_horizontal_padding"
        android:paddingBottom="@dimen/content_vertical_padding">

        <Button
            android:id="@+id/buttonSave"
            style="@style/PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_save" />

        <Button
            android:id="@+id/buttonCancel"
            style="@style/SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/cancel" />
    </LinearLayout>

</LinearLayout>
