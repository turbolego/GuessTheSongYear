<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/editVideoId"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Video ID (11 chars)"
                android:text="dQw4w9WgXcQ"
                android:gravity="center"
                android:background="@color/surface"
                android:textColor="@color/body_text"
                android:textColorHint="@color/muted_text"
                android:paddingHorizontal="8dp"
                android:maxLength="11"
                android:inputType="text" />

            <Button
                android:id="@+id/buttonTestPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text="▶ Test"
                android:textColor="@color/ink"
                android:backgroundTint="@color/amber_accent"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/buttonClearLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tøm"
                android:textColor="@color/muted_text"
                android:backgroundTint="@color/surface"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Status bar -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Klar"
            android:textSize="12sp"
            android:textColor="@color/amber_accent"
            android:background="@color/surface"
            android:visibility="gone" />

        <!-- Scrollable log -->
        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/surface">

            <TextView
                android:id="@+id/textLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:typeface="monospace"
                android:textColor="@color/green_correct"
                android:lineSpacingExtra="0dp"
                android:padding="4dp"
                android:text="Trykk ▶ Test for å starte" />

        </ScrollView>

        <!-- Bottom info -->
        <TextView
            android:id="@+id/textInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textSize="10sp"
            android:textColor="@color/muted_text"
            android:text="Logger v1.0 — maks 200 oppføringer" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
